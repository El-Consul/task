generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        String   @default("SALES_AGENT")
  permissions String   @default("[]") // Changed to String because SQLite doesn't support String[]
  isActive    Boolean  @default(true)
  resetToken  String?
  resetTokenExpiry DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients   Client[]
  auditLogs AuditLog[]
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String?
  price     Float
  area      Float?   // مساحة الوحدة
  status    String   @default("AVAILABLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          Int      @id @default(autoincrement()) // رقم العميل
  name        String
  phone       String
  unitNumber  String?
  unitCode    String?
  unitArea    Float?
  groupId     Int?
  
  email       String?
  idNumber    String?
  agentId     String?
  agent       User?    @relation(fields: [agentId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paymentPlans PaymentPlan[]
}

model PaymentPlan {
  id               String   @id @default(uuid())
  clientId         Int
  unitPrice        Float
  contractDate     DateTime
  deposit          Float
  remainingAmount  Float
  assessmentAmount Float?   // مبلغ المقايسة
  measurements     Float?
  deposit10Percent Float?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client           Client   @relation(fields: [clientId], references: [id])
  installments     Installment[]
}

model Installment {
  id            String   @id @default(uuid())
  paymentPlanId String
  amount        Float
  dueDate       DateTime
  type          String   @default("REGULAR") // REGULAR, DELIVERY, MAINTENANCE, FINAL
  status        String   @default("PENDING") // PENDING, PAID
  paymentMethod String?  // CHECK, CASH, TRANSFER
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paymentPlan   PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  payments      Payment[]
  notifications Notification[]
}

model Notification {
  id            String    @id @default(uuid())
  installmentId String
  type          String
  status        String    @default("PENDING")
  scheduledFor  DateTime
  sentAt        DateTime?
  errorLog      String?
  createdAt     DateTime  @default(now())

  installment   Installment @relation(fields: [installmentId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  installmentId String
  amount        Float
  paymentDate   DateTime @default(now())
  receiptUrl    String?
  reference     String?
  createdAt     DateTime @default(now())

  installment   Installment @relation(fields: [installmentId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])
}
